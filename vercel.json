{
  "version": 2,
  "crons": [
    {
      "path": "/api/scout-events?city=Chicago,%20IL",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/event-scout-web",
      "schedule": "0 15 * * 0"
    }
  ],
  "functions": {
    "api/search.js": {
      "maxDuration": 60
    },
    "api/home-feed.js": {
      "maxDuration": 30
    },
    "api/places-enrich.js": {
      "maxDuration": 30
    },
    "api/photo.js": {
      "maxDuration": 10
    },
    "api/neighborhoods.js": {
      "maxDuration": 30
    },
    "api/events.js": {
      "maxDuration": 30
    },
    "api/scout-events.js": {
      "maxDuration": 60
    },
    "api/submit-event.js": {
      "maxDuration": 15
    },
    "api/event-scout-web.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-Sabor-Key" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
